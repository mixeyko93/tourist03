# Copy to .env for local development. Do not commit .env or real credentials.
ENVIRONMENT=development
DEBUG=false
APP_VERSION=local
PUBLIC_BASE_URL=http://localhost:8000

# PostgreSQL (development defaults are deliberately rejected in production).
PG_HOST=localhost
PG_PORT=5432
PG_DB=tourist03
PG_USER=postgres
PG_PASSWORD=postgres

# Sessions and browser security. Generate a long random value for production.
SESSION_SECRET_KEY=development-only-session-secret-change-before-production
SESSION_COOKIE_NAME=t03_admin_session
SESSION_COOKIE_MAX_AGE=604800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-CSRF-Token,X-Superadmin-Key

# Panel access: fill only in the private .env.
SUPERADMIN_API_KEY=
SUPERADMIN_LOGIN=
SUPERADMIN_PASSWORD=
SUPERADMIN_LOCAL_BYPASS=false

# Development-only authentication simulation. Both values must be disabled in production.
SIM_VERIFY_CODE=0000
ALLOW_SIMULATED_AUTH=true
TERMS_VERSION=2026-01-04

# URLs and Telegram/VK integrations.
CRM_BASE_URL=https://crm.turist03.ru
SUPERADMIN_BASE_URL=https://superadmin.turist03.ru
BOT_TOKEN=
WEBAPP_URL=
STAFF_BOT_TOKEN=
STAFF_BOT_USERNAME=
STAFF_BOT_POLL_INTERVAL=60
VK_TOKEN=
VK_GROUP_ID=
TOURIST_WEBAPP_URL=

# SMTP (optional until mail delivery is enabled).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Protected uploads: image files are verified by Pillow. Server video is opt-in.
UPLOAD_DIR=./static/uploads
UPLOAD_IMAGE_MAX_BYTES=10485760
UPLOAD_VIDEO_MAX_BYTES=104857600
ALLOW_SERVER_VIDEO_UPLOAD=false

# In-memory limiting is suitable only for one process. Configure Redis before scale-out.
RATE_LIMIT_STORAGE=memory
REDIS_URL=
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_PUBLIC_POST_PER_MINUTE=20
CSRF_LEGACY_COMPATIBILITY=false

# Public launch switches: all remain closed during Stage 1.1.
FEATURE_PUBLIC_BOOKING=false
FEATURE_PUBLIC_USER_AUTH=false
FEATURE_OWNER_PORTAL=false
FEATURE_SERVICES=false
FEATURE_TELEGRAM_WEBAPP=false
FEATURE_PAID_PLACEMENT=false
FEATURE_LEGACY_TOURIST_APP=false
