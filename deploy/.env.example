# Production template. Replace every placeholder in the private deploy/.env.
DOMAIN_ROOT=turist03.ru
DOMAIN_APP=app.turist03.ru
DOMAIN_SUPERADMIN=superadmin.turist03.ru
DOMAIN_CRM=crm.turist03.ru
ADMIN_USER=admin
ADMIN_PASS_HASH=

ENVIRONMENT=production
DEBUG=false
APP_VERSION=
PUBLIC_BASE_URL=https://turist03.ru
OWNER_BASE_URL=https://lk.turist03.ru

PG_HOST=db
PG_PORT=5432
PG_DB=tourist03
PG_USER=tourist03
PG_PASSWORD=replace-with-unique-database-password

SESSION_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
SESSION_COOKIE_NAME=t03_admin_session
SESSION_COOKIE_MAX_AGE=604800
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
CORS_ORIGINS=https://turist03.ru,https://crm.turist03.ru,https://superadmin.turist03.ru
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-CSRF-Token,X-Superadmin-Key

SUPERADMIN_API_KEY=replace-with-unique-api-key
SUPERADMIN_LOGIN=
SUPERADMIN_PASSWORD=
SUPERADMIN_LOCAL_BYPASS=false
SIM_VERIFY_CODE=
ALLOW_SIMULATED_AUTH=false
TERMS_VERSION=2026-01-04

CRM_BASE_URL=https://crm.turist03.ru
SUPERADMIN_BASE_URL=https://superadmin.turist03.ru
BOT_TOKEN=
WEBAPP_URL=https://turist03.ru/
STAFF_BOT_TOKEN=
STAFF_BOT_USERNAME=
STAFF_BOT_POLL_INTERVAL=60
VK_TOKEN=
VK_GROUP_ID=
TOURIST_WEBAPP_URL=https://turist03.ru

# Public browser key for the official Yandex Maps Tiles API; restrict it to turistika.pro.
YANDEX_MAPS_TILES_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SUPPORT_NOTIFICATION_EMAIL=
SMTP_USE_TLS=true

FEATURE_PLACEMENT_SUBMISSIONS=false
SUBMISSION_MAX_PLACE_PHOTOS=20
SUBMISSION_MAX_ROOM_PHOTOS=5
SUBMISSION_MAX_IMAGE_BYTES=10485760
SUBMISSION_MAX_IMAGE_PIXELS=40000000
SUBMISSION_MAX_JSON_BYTES=1048576
SUBMISSION_DRAFT_TTL_HOURS=168
SUBMISSION_UPLOAD_TTL_HOURS=48
SUBMISSION_MIN_FILL_SECONDS=20
SUBMISSION_MAX_LINKS=12
SUBMISSION_RATE_PER_HOUR=5
SUBMISSION_CAPTCHA_PROVIDER=http
SUBMISSION_CAPTCHA_VERIFY_URL=
SUBMISSION_CAPTCHA_SECRET=
SUBMISSION_CAPTCHA_CLIENT_SCRIPT_URL=
SUBMISSION_CAPTCHA_SITE_KEY=
SUBMISSION_CAPTCHA_TEST_TOKEN=
SUBMISSION_RETENTION_REJECTED_DAYS=365
SUBMISSION_RETENTION_ABANDONED_DAYS=30
SUBMISSION_RETENTION_TECHNICAL_DAYS=90
SUBMISSION_CLEANUP_ENABLED=false

UPLOAD_DIR=/app/static/uploads
UPLOAD_IMAGE_MAX_BYTES=10485760
UPLOAD_VIDEO_MAX_BYTES=104857600
ALLOW_SERVER_VIDEO_UPLOAD=false

RATE_LIMIT_STORAGE=memory
REDIS_URL=
RATE_LIMIT_MEMORY_MAX_KEYS=10000
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_PUBLIC_POST_PER_MINUTE=20
RATE_LIMIT_PUBLIC_SEARCH_PER_MINUTE=240
CSRF_LEGACY_COMPATIBILITY=false

# Public catalog visibility is database-driven (published + legacy active/published).
# Keep later product contours disabled until their own acceptance stage.
FEATURE_PUBLIC_BOOKING=false
FEATURE_PUBLIC_USER_AUTH=false
FEATURE_OWNER_PORTAL=false
FEATURE_OWNER_CHANGE_REQUESTS=false
FEATURE_OWNER_PASSWORD_RESET=false
FEATURE_SERVICES=false
FEATURE_TELEGRAM_WEBAPP=false
FEATURE_TELEGRAM_CONTACT=false
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEEP_LINK_SECRET=
TELEGRAM_SUPPORT_CHAT_ID=0
TELEGRAM_SUPPORT_TOPIC_GENERAL=0
TELEGRAM_SUPPORT_TOPIC_PLACEMENT=0
TELEGRAM_SUPPORT_TOPIC_PREMIUM=0
TELEGRAM_SUPPORT_TOPIC_BUG=0
TELEGRAM_SUPPORT_TOPIC_SUGGESTION=0
TELEGRAM_SUPPORT_OPERATOR_IDS=
FEATURE_PAID_PLACEMENT=false
FEATURE_LEGACY_TOURIST_APP=false
